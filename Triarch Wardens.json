              {
                "name": "Cunning Strategist",
                "id": "a5de-ab9b-9ec4-6fb3",
                "hidden": false,
                "typeId": "9cc3-6d83-4dd3-9b64",
                "typeName": "Abilities",
                "characteristics": [
                  {
                    "name": "Description",
                    "$text": "After both players have deployed their armies, before the first turn begins, you can redeploy up to two ADEPTUS ASTARTES units from your army. When doing so, you can place those units into Strategic Reserves, regardless of how many units are already in Strategic Reserves.",
                    "typeId": "9b8f-694b-e5e-b573"
                  }
                ]
              },
